  "acceptanceCriteria": [
    {
      "id": "C1-S01",
      "case": "Prerequisite c1-b1 absent: entry/confirm blocked",
      "expected": {
        "entryGrants": 0,
        "commits": 0
      }
    },
    {
      "id": "C1-S02",
      "case": "Observe exact authored records, preserve both on first read, duplicate observation idempotent",
      "expected": {
        "observations": 2,
        "sourceMismatches": 0,
        "automaticBackups": 2,
        "verifiedSheetCopies": 0
      }
    },
    {
      "id": "C1-S03",
      "case": "Unselected and three ordinal humidity states; explicit low trial permits separation only",
      "expected": {
        "totalStates": 4,
        "safeLevels": 1,
        "unsafeLevels": 2,
        "unselectedSeparationGrants": 0
      }
    },
    {
      "id": "C1-S04",
      "case": "Medium/high trials then reset/retry do not destroy originals, backups, copies or prior progress",
      "expected": {
        "originalDamage": 0,
        "lostBackups": 0,
        "cost": 0,
        "completionGrants": 0
      }
    },
    {
      "id": "C1-S05",
      "case": "Separation before source observation or successful trial rejected; valid repeated separation idempotent",
      "expected": {
        "invalidGrants": 0,
        "validSeparationCount": 1
      }
    },
    {
      "id": "C1-S06",
      "case": "Two explicit per-sheet copies after separation; duplicate sheet action not a third copy",
      "expected": {
        "distinctCopies": 2,
        "duplicateAddedCopies": 0,
        "independentRoots": 1
      }
    },
    {
      "id": "C1-S07",
      "case": "One copy-local lower region marked only after second copy exists; remains unreadable",
      "expected": {
        "regionCount": 1,
        "unresolvedRegionCount": 1,
        "newReadableNames": 0
      }
    },
    {
      "id": "C1-S08",
      "case": "Explicit comparison requires both observations and copies and preserves exact origins",
      "expected": {
        "comparisonCount": 1,
        "sourceMismatches": 0,
        "inventedNumericSamples": 0
      }
    },
    {
      "id": "C1-S09",
      "case": "Valid log/plate pair accepted; same-root copies and same-type pairs rejected",
      "expected": {
        "acceptedPairCount": 1,
        "sameRootAccepted": 0,
        "sameTypeAccepted": 0
      }
    },
    {
      "id": "C1-S10",
      "case": "Missing any readiness predicate blocks confirmation even when all others are ready",
      "expected": {
        "partialApplications": 0,
        "completionGrants": 0
      }
    },
    {
      "id": "C1-S11",
      "case": "Current successful save receipt commits all effects exactly once",
      "expected": {
        "atomicEffectCount": 6,
        "completedBeatsAdded": 1,
        "checkpointsAdded": 1
      }
    },
    {
      "id": "C1-S12",
      "case": "Immediate submission, cancel, failed write, stale/duplicate receipt cannot commit or partially apply",
      "expected": {
        "prematureCommits": 0,
        "partialApplications": 0,
        "duplicateApplications": 0
      }
    },
    {
      "id": "C1-S13",
      "case": "Whole citation undo/redo preserves backup and prior T0/c1-b1 state",
      "expected": {
        "partialStates": 0,
        "lostAutomaticBackups": 0,
        "priorStateMismatches": 0
      }
    },
    {
      "id": "C1-S14",
      "case": "Actual v1/v2 fixture migration to v3 retains command identity/hash; future versions refused",
      "expected": {
        "supportedReadVersions": 3,
        "priorIdentityMismatches": 0,
        "discardedOriginalBackups": 0,
        "futureVersionsAccepted": 0
      }
    },
    {
      "id": "C1-S15",
      "case": "Level-zero default omits solution; each explicit hint reveal advances at most one layer and changes no puzzle state",
      "expected": {
        "defaultHintLevel": 0,
        "hintLayers": 3,
        "maxIncrement": 1,
        "stateMutations": 0,
        "defaultSolutionLines": 0
      }
    },
    {
      "id": "C1-S16",
      "case": "150% text remains readable; pointer keyboard pad expose actions; art does not reveal name",
      "expected": {
        "textScale": 1.5,
        "requiredInputPaths": 3,
        "missingLocalizationKeys": 0,
        "colorOnlyStates": 0,
        "readableHiddenNames": 0
      }
    },
    {
      "id": "C1-S17",
      "case": "Native save/restart preserves completed c1-b2 evidence and shows bounded endpoint",
