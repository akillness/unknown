    {\n          \"lineId\": \"wb-l1\",\n          \"kind\": \"clause\",\n         
    \"text\": \"\uACC4\uD1B5\uC5D0 \uB0A8\uB294 \uAC83\uC740 \uBC38\uBE0C \uAC1C\uD3D0,
    \uAD00 \uC555\uB825, \uC5FC\uB3C4, \uC218\uC704, \uBB38 \uAC1C\uD3D0, \uB2F9\uC9C1
    \uD638\uCD9C, \uBD09\uC778 \uC644\uB8CC \uC811\uC810\uC5D0 \uD55C\uD55C\uB2E4.\",\n         
    \"flag\": \"quote:bible \xA72\"\n        },\n        {\n          \"lineId\":
    \"wb-l2\",\n          \"kind\": \"clause\",\n          \"text\": \"\uD68C\uC120\uC774
    \uAE54\uB9B0 3\uAC1C\uC18C \u2014 \uB2F9\uC9C1\uC2E4\xB7\uC81C3\uC218\uBB38\xB7\uBD80\uB450\uC0AC\uBB34\uC18C
    \u2014 \uC5D0 \uD55C\uD574 \uD1B5\uD654\uC758 \uAC1C\uC2DC \uC2DC\uAC01\uACFC
    \uACC4\uD1B5\uB9CC \uB0A8\uAE34\uB2E4. \uD1B5\uD654 \uB0B4\uC6A9\uC740 \uB0A8\uAE30\uC9C0
    \uC54A\uB294\uB2E4.\",\n          \"flag\": \"quote:bible \xA72\"\n        },\n       
    {\n          \"lineId\": \"wb-l3\",\n          \"kind\": \"clause\",\n         
    \"text\": \"\uC13C\uC11C \uBC16 \uC0AC\uAC74\uC740 \uAE30\uB85D\uB9CC\uC73C\uB85C
    \uD655\uC815\uD560 \uC218 \uC5C6\uB2E4. \uADFC\uAC70 \uBD80\uC871 \uC0AC\uC720\uB97C
    \uC801\uACE0 \uD310\uC815\uC744 \uBCF4\uB958\uD55C\uB2E4.\",\n          \"flag\":
    \"quote:bible \xA73 \uBC951\"\n        },\n        {\n          \"lineId\": \"wb-l4\",\n         
    \"kind\": \"margin\",\n          \"text\": \"\uC81C2\uC870\uB294 \uAC1C\uC18C
    \uC218\uB9CC \uC62E\uACA8 \uC801\uC5C8\uB2E4. \uAC1C\uC18C\uBCC4 \uD68C\uC120
    \uBC88\uD638\uB294 \uC6D0\uBCF8\uC5D0 \uC788\uB2E4.\",\n          \"flag\": \"omission
    \u2014 \uD544\uC0AC\uBCF8\uC758 \uB204\uB77D \uC608\uC2DC\"\n        }\n     
