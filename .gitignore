# harness memory-stack local state
.zvec-grep/
.mex/graph.db
.mex/*.db-journal
# editor/OS
.DS_Store
# generated assets never promoted without provenance
_workspace/current/**/*.tmp

# graphify code-graph local cache/render (graph.json + GRAPH_REPORT.md stay tracked)
graphify-out/cache/
graphify-out/graph.html

# OMC session/agent local state (machine-local, not shared source of truth)
.omc/

# pdfTeX `mex` name-collision artifact (TeX Live), not a harness output
texput.log

# Unity editor caches created by opening the repository root as a project
# (canonical project is unity/Unknown/; these are regenerable)
/Library/
/Temp/
/Logs/
/UserSettings/
/Packages/
/ProjectSettings/
/assets/**/*.meta
unity/Unknown/mono_crash.*.json

# local ingest mirror of the llm-wiki vault (authoritative copy: ~/vaults/llm-wiki)
/llm-wiki/

# python bytecode from asset build scripts
__pycache__/

# jeo session/agent local state (machine-local, same class as .omc/)
.jeo/

# M7 heavy authoring blobs: regenerable from scripts/blender/build_m7_assets.py (deterministic,
# tracked) and redundant with the tracked FBX imports. Hashes stay recorded in
# assets/generated/3d/concept-first-m7/provenance.json (RFC-CX-013 decision).
assets/generated/3d/concept-first-m7/*.blend
assets/generated/3d/concept-first-m7/*.blend1
assets/generated/3d/concept-first-m7/*.glb
